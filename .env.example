# --- PayPal (developer.paypal.com → Apps & Credentials → Sandbox → your REST app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Optional: the Webhook ID shown after you add a webhook for https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Google Gemini (aistudio.google.com → Get API key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- App ---
PORT=3000
DEFAULT_CURRENCY=USD
# DATA_DIR=./data
